[gd_resource type="VisualShader" load_steps=5 format=3 uid="uid://sh10visradial1"]

; === EL MISMO SHADER, COMO GRAFO (✅ demo) ==================================
; Gemelo exacto de radial_codigo.gdshader: cada nodo de este grafo es una
; línea de aquel archivo. Ábrelo en el editor (doble clic) para ver el grafo.
; ============================================================================

[sub_resource type="VisualShaderNodeInput" id="VisualShaderNodeInput_uv"]
input_name = "uv"

[sub_resource type="VisualShaderNodeVectorOp" id="VisualShaderNodeVectorOp_resta"]
default_input_values = [0, Vector2(0, 0), 1, Vector2(0.5, 0.5)]
op_type = 0
operator = 1

[sub_resource type="VisualShaderNodeVectorLen" id="VisualShaderNodeVectorLen_dist"]
default_input_values = [0, Vector2(0, 0)]
op_type = 0

[sub_resource type="VisualShaderNodeSmoothStep" id="VisualShaderNodeSmoothStep_rampa"]
default_input_values = [0, 0.1, 1, 0.5, 2, 0.0]

[resource]
code = "shader_type canvas_item;
render_mode blend_mix;

void fragment() {
// Input:2
	vec2 n_out2p0 = UV;


// VectorOp:3
	vec2 n_in3p1 = vec2(0.50000, 0.50000);
	vec2 n_out3p0 = n_out2p0 - n_in3p1;


// VectorLen:4
	float n_out4p0 = length(n_out3p0);


// SmoothStep:5
	float n_in5p0 = 0.10000;
	float n_in5p1 = 0.50000;
	float n_out5p0 = smoothstep(n_in5p0, n_in5p1, n_out4p0);


// Output:0
	COLOR.rgb = vec3(n_out5p0);


}
"
mode = 1
flags/light_only = false
nodes/fragment/0/position = Vector2(900, 140)
nodes/fragment/2/node = SubResource("VisualShaderNodeInput_uv")
nodes/fragment/2/position = Vector2(-700, 140)
nodes/fragment/3/node = SubResource("VisualShaderNodeVectorOp_resta")
nodes/fragment/3/position = Vector2(-400, 140)
nodes/fragment/4/node = SubResource("VisualShaderNodeVectorLen_dist")
nodes/fragment/4/position = Vector2(-100, 140)
nodes/fragment/5/node = SubResource("VisualShaderNodeSmoothStep_rampa")
nodes/fragment/5/position = Vector2(300, 140)
nodes/fragment/connections = PackedInt32Array(2, 0, 3, 0, 3, 0, 4, 0, 4, 0, 5, 2, 5, 0, 0, 0)
